---
import '../styles/global.css'
import { TtsSettings } from '../components/react/TtsSettings'

interface Props {
  title?: string
  description?: string
  /** 分享預覽圖(站內絕對路徑,如 /images/classics/suwen-01.webp);未指定則用首頁橫幅。 */
  image?: string
}

const { title, description, image } = Astro.props
const fullTitle = title ? `${title}｜岐黃入門` : '岐黃入門｜中醫經典學習'
const desc =
  description ??
  '為準備入讀中醫課程的初學者而設：中醫基礎理論導覽、《黃帝內經》文白對讀、難字註與粵語朗讀。'
// OG 需要絕對網址;Astro.site 由 astro.config 嘅 site 提供
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(image ?? '/images/home-hero.webp', Astro.site)

const nav = [
  { href: '/foundations', label: '基礎' },
  { href: '/classics', label: '經典' },
  { href: '/glossary', label: '辭典' },
  { href: '/resources', label: '資源' },
  { href: '/progress', label: '進度' },
]
const path = Astro.url.pathname
---

<!doctype html>
<html lang="zh-Hant-HK">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical.href} />
    <title>{fullTitle}</title>

    {/* 分享預覽(WhatsApp/FB/Telegram 等) */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="岐黃入門" />
    <meta property="og:locale" content="zh_HK" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage.href} />
    <script is:inline>
      // 閱讀偏好防 FOUC:同 lib/reader.ts 嘅 class 名必須一致
      try {
        var rp = JSON.parse(localStorage.getItem('tcm.reader.v1') || '{}')
        var el = document.documentElement
        if (rp.fontScale === 's') el.classList.add('font-s')
        if (rp.fontScale === 'l') el.classList.add('font-l')
        if (rp.hideBaihua === true) el.classList.add('hide-baihua')
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen bg-white text-gray-900 flex flex-col">
    <header class="border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-3 sm:px-4 h-14 flex items-center justify-between gap-2">
        <a href="/" class="font-bold text-amber-900 shrink-0 text-[15px] sm:text-base">岐黃入門</a>
        <nav class="flex items-center gap-0 sm:gap-2 text-[13px] sm:text-sm overflow-x-auto" aria-label="主導覽">
          {
            nav.map(item => (
              <a
                href={item.href}
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
                class={`px-1.5 sm:px-2 py-1.5 rounded-md whitespace-nowrap transition-colors ${
                  path.startsWith(item.href)
                    ? 'text-amber-900 bg-amber-50 font-semibold'
                    : 'text-gray-600 hover:text-amber-800 hover:bg-amber-50'
                }`}
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="/search"
            aria-label="全文搜尋"
            title="全文搜尋"
            class={`px-2 py-1.5 rounded-md transition-colors ${
              path.startsWith('/search')
                ? 'text-amber-900 bg-amber-50'
                : 'text-gray-600 hover:text-amber-800 hover:bg-amber-50'
            }`}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          </a>
        </nav>
        <TtsSettings client:load />
      </div>
    </header>

    <main class="flex-1 w-full max-w-3xl mx-auto px-4 py-8" data-pagefind-body>
      <slot />
    </main>

    <footer class="border-t border-gray-200 mt-8">
      <div class="max-w-3xl mx-auto px-4 py-6 text-xs text-gray-400 leading-relaxed">
        <p>原文據公共領域通行本錄入；白話與註釋僅供學習參考，不構成醫療建議。</p>
      </div>
    </footer>
  </body>
</html>
