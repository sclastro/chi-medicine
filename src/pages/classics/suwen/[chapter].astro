---
import Base from '../../../layouts/Base.astro'
import SectionReader from '../../../components/SectionReader.astro'
import { ChapterPlayer } from '../../../components/react/ChapterPlayer'
import { QuizCards } from '../../../components/react/QuizCards'
import { ReadToggle } from '../../../components/react/ReadToggle'
import { getBook, isChapterReady } from '../../../data'

export function getStaticPaths() {
  // 只為已有內容嘅篇章建頁;待補篇章喺目錄以灰卡顯示、不可進入
  const suwen = getBook('suwen')!
  return suwen.chapters
    .filter(isChapterReady)
    .map(c => ({ params: { chapter: c.id }, props: { chapter: c } }))
}

const { chapter } = Astro.props
const suwen = getBook('suwen')!
const readyChapters = suwen.chapters.filter(isChapterReady)
const idx = readyChapters.findIndex(c => c.id === chapter.id)
const prev = idx > 0 ? readyChapters[idx - 1] : null
const next = idx < readyChapters.length - 1 ? readyChapters[idx + 1] : null
---

<Base title={`${chapter.title}｜素問`} description={chapter.intro} image={chapter.image}>
  {
    chapter.image ? (
      <img
        src={chapter.image}
        alt={`${chapter.title}意境圖`}
        width="1024"
        height="683"
        loading="eager"
        class="w-full max-w-lg mx-auto rounded-lg mb-5"
      />
    ) : null
  }
  {/* 閱讀進度條:長篇(最長 327 段)要知讀到邊。貼喺頁頂,唔佔版面 */}
  <div id="read-progress" class="fixed top-0 left-0 right-0 h-[3px] z-30 bg-transparent" aria-hidden="true">
    <div id="read-progress-bar" class="h-full w-0 bg-amber-600 transition-[width] duration-75"></div>
  </div>

  <p class="text-xs text-gray-400 mb-1">
    <a href="/classics/suwen" class="hover:text-amber-700">素問</a> · 第{chapter.number}篇
    {chapter.featured ? (
      <span class="text-[10px] text-amber-700 bg-amber-100 rounded px-1.5 py-0.5 ml-1">基礎</span>
    ) : null}
    <span class="ml-1">· 共 {chapter.sections.length} 段</span>
  </p>
  <h1 class="text-2xl font-bold text-amber-900 mb-3">{chapter.title}</h1>

  {
    chapter.intro ? (
      <div class="rounded-lg bg-amber-50 border border-amber-100 p-4 mb-8">
        <h2 class="text-xs font-semibold text-amber-800 mb-1">導讀</h2>
        <p class="text-sm text-gray-700 leading-relaxed">{chapter.intro}</p>
      </div>
    ) : null
  }

  {/* 圖示只定義一次,各段以 <use> 引用 —— 327 段嘅長篇可省數百 KB 重複 SVG markup */}
  <svg width="0" height="0" class="hidden" aria-hidden="true">
    <defs>
      <path id="ico-bookmark" d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <g id="ico-playfrom"><path d="M4 5v14l8-7z" /><path d="M13 5v14l8-7z" /></g>
      <path id="ico-chevron" d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </defs>
  </svg>

  <div class="mb-6">
    {/* client:idle(唔用 visible):由書籤錨點跳入長篇深處時會略過播放器,
        未 hydrate 就收唔到「由此段朗讀到尾」嘅事件。只此一個 island,成本極低。 */}
    <ChapterPlayer client:idle chapterId={chapter.id} count={chapter.sections.length} />
  </div>

  <div class="mb-8">
    {chapter.sections.map((s, i) => (
      <SectionReader section={s} chapterId={chapter.id} index={i} />
    ))}
  </div>

  <div class="mb-8 flex justify-center">
    <ReadToggle client:visible chapterId={chapter.id} />
  </div>

  {
    chapter.quiz?.length ? (
      <section class="mb-8">
        <h2 class="font-semibold text-amber-900 mb-3">自測</h2>
        <QuizCards client:visible items={chapter.quiz} ownerId={chapter.id} />
      </section>
    ) : null
  }

  <nav class="flex justify-between text-sm border-t border-gray-200 pt-4" aria-label="篇章導航">
    {prev ? <a href={`/classics/suwen/${prev.id}`} class="text-amber-700 hover:underline">← {prev.title}</a> : <span />}
    {next ? <a href={`/classics/suwen/${next.id}`} class="text-amber-700 hover:underline">{next.title} →</a> : <span />}
  </nav>

  {/* 段序指示:碌落去先出現,同返頂掣並排 */}
  <div
    id="sec-indicator"
    class="hidden fixed bottom-5 right-16 z-10 rounded-full bg-white border border-gray-200 shadow-md px-3 h-10 items-center text-xs text-gray-600 tabular-nums"
    aria-live="polite"
  >
  </div>

  <button
    type="button"
    id="back-to-top"
    aria-label="返回頂部"
    title="返回頂部"
    class="hidden fixed bottom-5 right-4 z-10 w-11 h-11 rounded-full bg-white border border-gray-200 shadow-md text-amber-800 items-center justify-center hover:bg-amber-50 transition-colors"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
  </button>

  <script>
    import { setLastRead } from '../../../lib/progress'
    import { initSectionControls } from '../../../lib/sectionControls'

    // 段落朗讀/書籤/難字點讀:一個事件代理取代每段 3 個 island
    initSectionControls()

    // 「繼續閱讀」:記低本篇為最後閱讀
    const m = location.pathname.match(/suwen-\d+/)
    if (m) setLastRead(m[0])

    // 原文自測模式:逐段「顯示白話」展開(事件代理)
    document.addEventListener('click', e => {
      const target = e.target as Element | null
      const btn = target?.closest?.('.baihua-reveal')
      if (btn) btn.closest('.baihua-wrap')?.classList.add('revealed')

      // 「由此段朗讀到尾」:以事件通知 ChapterPlayer island 接手播放
      const playFrom = target?.closest?.('.play-from')
      if (playFrom) {
        const index = Number((playFrom as HTMLElement).dataset.index)
        if (Number.isInteger(index)) {
          document.dispatchEvent(new CustomEvent('tcm:play-from', { detail: { index } }))
        }
      }
    })

    // 長篇:返頂浮掣 + 頁頂進度條 + 段序指示(全部由同一個 scroll listener 驅動)
    const topBtn = document.getElementById('back-to-top')
    const bar = document.getElementById('read-progress-bar')
    const indicator = document.getElementById('sec-indicator')
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-section]'))
    const total = sections.length

    let ticking = false
    const update = () => {
      ticking = false
      const y = window.scrollY
      const show = y > 600

      if (topBtn) {
        topBtn.classList.toggle('hidden', !show)
        topBtn.classList.toggle('flex', show)
      }

      // 進度條:以整份文件可捲範圍計
      if (bar) {
        const max = document.documentElement.scrollHeight - window.innerHeight
        bar.style.width = `${max > 0 ? Math.min(100, (y / max) * 100) : 0}%`
      }

      // 段序:視窗上緣算落嚟,最後一個已經捲過嘅段
      if (indicator && total) {
        indicator.classList.toggle('hidden', !show)
        indicator.classList.toggle('flex', show)
        if (show) {
          const probe = y + window.innerHeight * 0.3
          let cur = 0
          for (let i = 0; i < total; i++) {
            if (sections[i].offsetTop <= probe) cur = i + 1
            else break
          }
          indicator.textContent = `${cur || 1}／${total} 段`
        }
      }
    }

    const onScroll = () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll, { passive: true })
    topBtn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))
    update()
  </script>
</Base>
