---
import Base from '../../layouts/Base.astro'
import { QuizCards } from '../../components/react/QuizCards'
import { foundations, getChapter, isChapterReady } from '../../data'

export function getStaticPaths() {
  return foundations.map(t => ({ params: { topic: t.id }, props: { topic: t } }))
}

const { topic } = Astro.props
const idx = foundations.findIndex(t => t.id === topic.id)
const prev = idx > 0 ? foundations[idx - 1] : null
const next = idx < foundations.length - 1 ? foundations[idx + 1] : null
---

<Base title={topic.title} description={topic.intro}>
  {
    topic.image ? (
      <img
        src={topic.image}
        alt={`${topic.title}示意圖`}
        loading="eager"
        class="w-full max-w-lg mx-auto rounded-lg mb-5"
      />
    ) : null
  }
  <p class="text-xs text-amber-700 mb-1">{topic.courseRef}</p>
  <h1 class="text-2xl font-bold text-amber-900 mb-3">{topic.title}</h1>
  <p class="text-gray-600 leading-relaxed mb-8">{topic.intro}</p>

  {
    topic.sections.length ? (
      <div class="mb-8">
        {topic.sections.map(s => (
          <section class="mb-8">
            <h2 class="font-semibold text-amber-900 mb-2">{s.heading}</h2>
            <div class="text-gray-700 leading-relaxed whitespace-pre-line">{s.body}</div>
            {s.refs?.length ? (
              <p class="text-xs mt-2 space-x-3">
                <span class="text-gray-400">原文出處：</span>
                {s.refs.map(r => {
                  const ch = getChapter(r.bookId, r.chapterId)
                  return ch && isChapterReady(ch) ? (
                    <a href={`/classics/${r.bookId}/${r.chapterId}`} class="text-amber-700 hover:underline">
                      {r.label}
                    </a>
                  ) : (
                    <span class="text-gray-400">{r.label}（待補）</span>
                  )
                })}
              </p>
            ) : null}
          </section>
        ))}
      </div>
    ) : (
      <p class="text-gray-400 text-sm mb-8">本篇內容整理中，敬請期待。</p>
    )
  }

  {
    topic.quiz?.length ? (
      <section class="mb-8">
        <h2 class="font-semibold text-amber-900 mb-3">自測</h2>
        <QuizCards client:visible items={topic.quiz} ownerId={topic.id} />
      </section>
    ) : null
  }

  <nav class="flex justify-between text-sm border-t border-gray-200 pt-4" aria-label="主題導航">
    {prev ? <a href={`/foundations/${prev.id}`} class="text-amber-700 hover:underline">← {prev.title}</a> : <span />}
    {next ? <a href={`/foundations/${next.id}`} class="text-amber-700 hover:underline">{next.title} →</a> : <span />}
  </nav>
</Base>
