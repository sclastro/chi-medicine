---
// 文白對讀嘅一個閱讀段:原文(+朗讀掣+書籤掣) → 難字註(可點讀) → 白話(淺色左邊線)。
// 直排對讀為本站核心版式 —— 手機優先,唔用雙欄左右對照。
// 原文自測模式(html.hide-baihua)下白話摺埋,「顯示白話」逐段展開(delegation 喺 [chapter].astro)。
import { AnnotationChips } from './react/AnnotationChips'
import { BookmarkButton } from './react/BookmarkButton'
import { SpeakButton } from './react/SpeakButton'
import type { Section } from '../types/tcm'

interface Props {
  section: Section
  /** 所屬篇章 id(書籤用);未提供則不顯示書籤掣 */
  chapterId?: string
  /** 段序(0 起,書籤與錨點用) */
  index?: number
}

const { section, chapterId, index } = Astro.props
const speakId = chapterId != null && index != null ? `${chapterId}-s${index}` : `s-${section.original.slice(0, 8)}`
---

<div class="mb-8 scroll-mt-20" id={index != null ? `s${index}` : undefined}>
  <div class="flex items-start gap-1.5">
    <p class="flex-1 text-xl leading-loose text-gray-900">{section.original}</p>
    <div class="flex flex-col gap-1 items-center">
      <SpeakButton client:visible id={speakId} text={section.original} />
      {
        chapterId != null && index != null ? (
          <BookmarkButton client:visible chapterId={chapterId} sectionIndex={index} />
        ) : null
      }
    </div>
  </div>

  {
    section.annotations?.length ? (
      <AnnotationChips client:visible annotations={section.annotations} idPrefix={speakId} />
    ) : null
  }

  {
    section.baihua ? (
      <div class="baihua-wrap mt-3">
        <button type="button" class="baihua-reveal items-center gap-1 text-xs text-amber-700 hover:underline">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          顯示白話
        </button>
        <p class="baihua-block pl-3 border-l-2 border-amber-100 text-gray-600 leading-relaxed">
          {section.baihua}
        </p>
      </div>
    ) : null
  }
</div>
