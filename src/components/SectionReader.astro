---
// 文白對讀嘅一個閱讀段:原文(+朗讀掣+書籤掣) → 難字註 → 白話(淺色左邊線)。
// 直排對讀為本站核心版式 —— 手機優先,唔用雙欄左右對照。
import { BookmarkButton } from './react/BookmarkButton'
import { SpeakButton } from './react/SpeakButton'
import type { Section } from '../types/tcm'

interface Props {
  section: Section
  /** 所屬篇章 id(書籤用);未提供則不顯示書籤掣 */
  chapterId?: string
  /** 段序(0 起,書籤與錨點用) */
  index?: number
}

const { section, chapterId, index } = Astro.props
const speakId = chapterId != null && index != null ? `${chapterId}-s${index}` : `s-${section.original.slice(0, 8)}`
---

<div class="mb-8 scroll-mt-20" id={index != null ? `s${index}` : undefined}>
  <div class="flex items-start gap-1.5">
    <p class="flex-1 text-xl leading-loose text-gray-900">{section.original}</p>
    <div class="flex flex-col gap-1 items-center">
      <SpeakButton client:visible id={speakId} text={section.original} />
      {
        chapterId != null && index != null ? (
          <BookmarkButton client:visible chapterId={chapterId} sectionIndex={index} />
        ) : null
      }
    </div>
  </div>

  {
    section.annotations?.length ? (
      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500">
        {section.annotations.map(a => (
          <span class="inline-flex items-baseline gap-1">
            <span class="text-amber-800 font-semibold text-sm">{a.char}</span>
            <span class="text-gray-400">{a.jyutping}</span>
            <span>{a.meaning}</span>
          </span>
        ))}
      </div>
    ) : null
  }

  {
    section.baihua ? (
      <p class="mt-3 pl-3 border-l-2 border-amber-100 text-gray-600 leading-relaxed">
        {section.baihua}
      </p>
    ) : null
  }
</div>
