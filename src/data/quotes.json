[
  {
    "chapterId": "suwen-01",
    "text": "法於陰陽，和於術數，食飲有節，起居有常，不妄作勞，故能形與神俱，而盡終其天年，度百歲乃去。"
  },
  {
    "chapterId": "suwen-01",
    "text": "恬惔虛無，真氣從之，精神內守，病安從來。"
  },
  {
    "chapterId": "suwen-02",
    "text": "聖人春夏養陽，秋冬養陰，以從其根"
  },
  {
    "chapterId": "suwen-02",
    "text": "聖人不治已病治未病，不治已亂治未亂"
  },
  {
    "chapterId": "suwen-02",
    "text": "夫病已成而後藥之，亂已成而後治之，譬猶渴而穿井，鬥而鑄錐，不亦晚乎！"
  },
  {
    "chapterId": "suwen-03",
    "text": "陽氣者若天與日，失其所則折壽而不彰"
  },
  {
    "chapterId": "suwen-03",
    "text": "凡陰陽之要，陽密乃固"
  },
  {
    "chapterId": "suwen-03",
    "text": "陰平陽秘，精神乃治，陰陽離決，精氣乃絕"
  },
  {
    "chapterId": "suwen-03",
    "text": "謹和五味，骨正筋柔，氣血以流，腠理以密"
  },
  {
    "chapterId": "suwen-04",
    "text": "夫精者，身之本也。故藏於精者，春不病溫。"
  },
  {
    "chapterId": "suwen-05",
    "text": "陰陽者，天地之道也，萬物之綱紀，變化之父母，生殺之本始，神明之府也，治病必求於本。"
  },
  {
    "chapterId": "suwen-05",
    "text": "清陽出上竅，濁陰出下竅"
  },
  {
    "chapterId": "suwen-05",
    "text": "重陰必陽，重陽必陰"
  },
  {
    "chapterId": "suwen-05",
    "text": "善診者，察色按脈，先別陰陽"
  },
  {
    "chapterId": "suwen-05",
    "text": "陽病治陰，陰病治陽"
  },
  {
    "chapterId": "suwen-08",
    "text": "心者，君主之官也，神明出焉。"
  },
  {
    "chapterId": "suwen-08",
    "text": "主明則下安，以此養生則壽"
  },
  {
    "chapterId": "suwen-09",
    "text": "心者，生之本，神之變也，其華在面，其充在血脈"
  },
  {
    "chapterId": "suwen-09",
    "text": "凡十一藏，取決於膽也。"
  },
  {
    "chapterId": "suwen-09",
    "text": "天食人以五氣，地食人以五味。"
  },
  {
    "chapterId": "suwen-10",
    "text": "肝受血而能視，足受血而能步，掌受血而能握，指受血而能攝。"
  },
  {
    "chapterId": "suwen-10",
    "text": "能合脈色，可以萬全。"
  },
  {
    "chapterId": "suwen-11",
    "text": "五藏者，藏精氣而不瀉也，故滿而不能實。六腑者，傳化物而不藏，故實而不能滿也。"
  },
  {
    "chapterId": "suwen-11",
    "text": "拘於鬼神者，不可與言至德。"
  },
  {
    "chapterId": "suwen-12",
    "text": "聖人雜合以治，各得其所宜"
  },
  {
    "chapterId": "suwen-14",
    "text": "病為本，工為標，標本不得，邪氣不服"
  },
  {
    "chapterId": "suwen-14",
    "text": "開鬼門，潔淨府"
  },
  {
    "chapterId": "suwen-17",
    "text": "診法常以平旦，陰氣未動，陽氣未散"
  },
  {
    "chapterId": "suwen-17",
    "text": "夫脈者，血之府也"
  },
  {
    "chapterId": "suwen-17",
    "text": "得守者生，失守者死。"
  },
  {
    "chapterId": "suwen-17",
    "text": "頭者精明之府，頭傾視深，精神將奪矣。"
  },
  {
    "chapterId": "suwen-21",
    "text": "四時陰陽，生病起於過用"
  },
  {
    "chapterId": "suwen-21",
    "text": "飲入於胃，遊溢精氣，上輸於脾。脾氣散精，上歸於肺，通調水道，下輸膀胱。"
  },
  {
    "chapterId": "suwen-21",
    "text": "經氣歸於肺，肺朝百脈，輸精於皮毛"
  },
  {
    "chapterId": "suwen-25",
    "text": "天覆地載，萬物悉備，莫貴於人"
  },
  {
    "chapterId": "suwen-25",
    "text": "凡刺之真，必先治神"
  },
  {
    "chapterId": "suwen-25",
    "text": "如臨深淵，手如握虎，神無營於眾物。"
  },
  {
    "chapterId": "suwen-39",
    "text": "百病生於氣也，怒則氣上，喜則氣緩，悲則氣消，恐則氣下，寒則氣收，炅則氣泄，驚則氣亂，勞則氣耗，思則氣結"
  },
  {
    "chapterId": "suwen-42",
    "text": "風者百病之長也，至其變化乃為他病也"
  },
  {
    "chapterId": "suwen-43",
    "text": "風寒濕三氣雜至，合而為痹也。"
  },
  {
    "chapterId": "suwen-43",
    "text": "其入藏者死，其留連筋骨間者疼久，其留皮膚間者易已。"
  },
  {
    "chapterId": "suwen-44",
    "text": "治痿者獨取陽明"
  },
  {
    "chapterId": "suwen-44",
    "text": "陽明者，五藏六腑之海，主潤宗筋"
  }
]
